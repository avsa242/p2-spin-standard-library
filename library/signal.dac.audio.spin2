{
----------------------------------------------------------------------------------------------------
    Filename:       signal.dac.audio.spin2
    Description:    DAC: Audio output
        * 1 or 2 channels (start 1 or 2 DACs initially, and output to 1 or both channels after)
        * 8-bit or 16-bit output
        * mono (single sample output to both channels)
        * stereo (independent sample output to each channel)
    Author:         Jesse Burt
    Started:        Mar 16, 2020
    Updated:        Jun 27, 2025
    Copyright (c) 2025 - See end of file for terms of use.
----------------------------------------------------------------------------------------------------
}

CON

    DAC_INIT_VAL        = 128

    ' 990ohm, 3Vp-p
    SP_DAC_MODE         = P_DAC_DITHER_PWM | P_DAC_990R_3V | P_OE | (DAC_INIT_VAL << sp.DACLEVEL)

    ' 600ohm, 2Vp-p
    LINELEVEL_MODE      = P_DAC_DITHER_RND | P_DAC_600R_2V | P_OE | (DAC_INIT_VAL << sp.DACLEVEL)


VAR

    long _CH1_PIN, _CH2_PIN


OBJ

    sp:     "core.con.smartpins"                ' smart-pin modes/constants
    evt:    "core.con.events"                   ' background events/constants


PUB start_linelevel_1ch(CH1_PIN, SRATE): s | per, se1setup
' Start single-channel 600Ohm, 2Vp-p line-level DAC
'   CH1_PIN:    output pin
'   SRATE:      output sample rate
'   Returns:    calling/parent cog ID+1 on success
'               false on failure (check I/O pin parameters)

    _CH1_PIN := -1
    if ( lookdown(CH1_PIN: 0..63) )
        _CH1_PIN := CH1_PIN
        per := (clkfreq / SRATE)
        se1setup := evt.INP_RISES | CH1_PIN     ' SE1 event: trigger on CH1 input rises
        org
            wrpin   ##LINELEVEL_MODE, CH1_PIN   ' Config pin for line-level output
            wxpin   per, CH1_PIN                ' Set sample period
            dirh    CH1_PIN                     ' Enable smart-pin
            setse1  se1setup                    ' trigger on every new sample period
        end
        return cogid() + 1
    return FALSE


PUB start_linelevel_2ch(CH1_PIN, CH2_PIN, SRATE): s | per, se1setup
' Start two-channel 600Ohm, 2Vp-p line-level DAC
'   CH1_PIN:    channel 1 pin
'   CH2_PIN:    channel 2 pin
'   SRATE:      sample rate (Hz)
'   Returns:    calling/parent cog ID+1 on success
'               false on failure (check I/O pin parameters)

    _CH1_PIN := _CH2_PIN := -1
    if ( lookdown(CH1_PIN: 0..63) and lookdown(CH2_PIN: 0..63) )
        longmove(@_CH1_PIN, @CH1_PIN, 2)
        per := (clkfreq / SRATE)
        se1setup := evt.INP_RISES | CH1_PIN     ' SE1 event: trigger on CH1 input rises
        org
            wrpin   ##LINELEVEL_MODE, CH1_PIN   ' Config pins for line-level output
            wrpin   ##LINELEVEL_MODE, CH2_PIN
            wxpin   per, CH1_PIN                ' Set sample period
            wxpin   per, CH2_PIN
            dirh    CH1_PIN                     ' Enable smart-pins
            dirh    CH2_PIN                     '
            setse1  se1setup                    ' trigger on every new sample
                                                '   period - on CH1_PIN rise
        end
        return cogid() + 1
    return FALSE


PUB stop()
' Stop the DACs

    if ( _CH1_PIN <> -1 )
        pinclear(_CH1_PIN)                      ' stop the smart-pin(s)
        _CH1_PIN := -1
    if ( _CH2_PIN <> -1 )
        pinclear(_CH2_PIN)
        _CH2_PIN := -1


PUB restart_1ch_sample_rate(r) | ch1
' Restart single-channel DAC with new sample rate, in Hz
'   r:  new sample rate
'   NOTE: This stops and re-starts the DAC smart pin

    ch1 := _CH1_PIN
    stop()
    start_linelevel_1ch(ch1, r)


PUB restart_2ch_sample_rate(r) | ch1, ch2
' Restart with new sample rate, in Hz
'   r:  new sample rate
'   NOTE: This stops and re-starts the DAC smart pins

    longmove(@ch1, @_CH1_PIN, 2)
    stop()
    start_linelevel_2ch(ch1, ch2, r)


PUB output16_ch1(smp) | CH1_PIN
' Output a 16-bit signed audio sample to channel 1 only
'   smp:    sample to output

    CH1_PIN := _CH1_PIN

    org
        xor     smp, ##$8000
        wypin   smp, CH1_PIN                    ' Output sample on first channel
        waitse1
    end


PUB output16_ch2(smp) | CH2_PIN
' Output a 16-bit signed audio sample to channel 2 only
'   smp:    sample to output

    CH2_PIN := _CH2_PIN

    org
        xor     smp, ##$8000
        wypin   smp, CH2_PIN                    ' Output sample on second channel
        waitse1
    end


PUB output16_2ch_mono(smp) | CH1_PIN, CH2_PIN
' Output a 16-bit signed audio sample (mono) to both channels
'   smp:    sample to output to both channels

    longmove(@CH1_PIN, @_CH1_PIN, 2)

    org
        xor     smp, ##$8000
        wypin   smp, CH1_PIN                    ' Output sample on first channel
        wypin   smp, CH2_PIN                    ' Output sample on second channel
        waitse1
    end


PUB output16_2ch_stereo(smp1, smp2) | CH1_PIN, CH2_PIN
' Output independent 16-bit signed audio samples (stereo)
'   smp1:  first channel sample
'   smp2:  second channel sample

    longmove(@CH1_PIN, @_CH1_PIN, 2)

    org
        xor     smp1, ##$8000
        xor     smp2, ##$8000
        wypin   smp1, CH1_PIN                   ' Output first channel sample
        wypin   smp2, CH2_PIN                   ' Output second channel sample
        waitse1
    end


PUB output8_ch1(smp) | CH1_PIN
' Output an 8-bit unsigned audio sample to channel 1 only
'   smp:    sample to output

    CH1_PIN := _CH1_PIN

    org
        xor     smp, ##$8000
        and     smp, #$FF
        wypin   smp, CH1_PIN                    ' Output sample on first channel
        waitse1
    end


PUB output8_ch2(smp) | CH2_PIN
' Output an 8-bit unsigned audio sample to channel 2 only
'   smp:    sample to output

    CH2_PIN := _CH2_PIN

    org
        xor     smp, ##$8000
        and     smp, #$FF
        wypin   smp, CH2_PIN                    ' Output sample on second channel
        waitse1
    end


PUB output8_2ch_mono(smp) | CH1_PIN, CH2_PIN
' Output an 8-bit unsigned audio sample (mono) to both channels
'   sample: sample to output to both channels

    longmove(@CH1_PIN, @_CH1_PIN, 2)

    org
        xor     smp, ##$8000
        and     smp, #$FF
        wypin   smp, CH1_PIN                    ' Output sample on first channel
        wypin   smp, CH2_PIN                    ' Output sample on second channel
        waitse1
    end


PUB output8_2ch_stereo(smp1, smp2) | CH1_PIN, CH2_PIN
' Output independent 8-bit unsigned audio samples (stereo)
'   smp1:  first channel sample
'   smp2:  second channel sample

    longmove(@CH1_PIN, @_CH1_PIN, 2)

    org
        xor     smp1, ##$8000
        xor     smp2, ##$8000
        and     smp1, #$ff
        and     smp2, #$ff
        wypin   smp1, CH1_PIN                   ' Output sample on first channel
        wypin   smp2, CH2_PIN                   ' Output sample on second channel
        waitse1
    end


DAT
