CON

    DAC_INIT_VAL        = 128
    SP_DAC_MODE         = P_DAC_990R_3V | (DAC_INIT_VAL << sp.DACLEVEL) | P_OE | P_DAC_DITHER_PWM


VAR

    long _L_PIN, _R_PIN


OBJ

    sp:     "core.con.smartpins"                  ' smart-pin modes/constants
    evt:    "core.con.events"                     ' background events/constants


PUB start(L_PIN, R_PIN, SAMPRATE_HZ): status | period, se1setup
' Start DAC smart-pin on L_PIN, R_PIN at SAMPRATE_HZ
    if lookdown(L_PIN: 0..63) and lookdown(R_PIN: 0..63)
        longmove(@_L_PIN, @L_PIN, 2)
        period := (clkfreq / SAMPRATE_HZ)

        se1setup := evt.INP_RISES | L_PIN
        org
            wrpin   ##SP_DAC_MODE, L_PIN        ' Config left and right pins
            wrpin   ##SP_DAC_MODE, R_PIN        '   for smart-pin DAC mode
            wxpin   period, L_PIN               ' Set sample period for left
            wxpin   period, R_PIN               '   and right channels
            dirh    L_PIN                       ' Enable smart-pins
            dirh    R_PIN                       '
            setse1  se1setup                    ' trigger on every new sample
                                                '   period - on L_PIN rise
        end
        return cogid() + 1
    return FALSE


PUB stop()
' Stop the DACs
    pinclear(_L_PIN)
    pinclear(_R_PIN)


PUB samplerate = sample_rate
PUB sample_rate(rate)
' Restart with new sample rate, in Hz
'   NOTE: This re-starts the DAC smart pins
    stop()
    start(_L_PIN, _R_PIN, rate)


PUB output16(sample) | L_PIN, R_PIN
' Output a 16-bit signed audio sample (mono)
'   sample: sample to output to both left and right channels
    longmove(@L_PIN, @_L_PIN, 2)
    org
        xor     sample, ##$8000
        wypin   sample, L_PIN                   ' Output sample on left channel
        wypin   sample, R_PIN                   ' Output sample on right channel
        waitse1
    end


PUB output16_pin(sample, lpin, rpin)
' Output a 16-bit signed audio sample (mono)
'   sample: sample to output to both left and right channels
'   lpin:   left audio pin
'   rpin:   right audio pin
    org
        xor     sample, ##$8000
        wypin   sample, lpin                    ' Output sample on left channel
        wypin   sample, rpin                    ' Output sample on right channel
        waitse1
    end


PUB output16_stereo(smp_l, smp_r) | L_PIN, R_PIN
' Output a 16-bit signed audio sample
'   smp_l:  left-channel sample
'   smp_r:  right-channel sample
    longmove(@L_PIN, @_L_PIN, 2)
    org
        xor     smp_l, ##$8000
        xor     smp_r, ##$8000
        wypin   smp_l, L_PIN                    ' Output sample on left channel
        wypin   smp_r, R_PIN                    ' Output sample on right channel
        waitse1
    end


PUB output16_stereo_pin(smp_l, smp_r, lpin, rpin)
' Output a 16-bit signed audio sample
'   smp_l:  left-channel sample
'   smp_r:  right-channel sample
'   lpin:   left audio pin
'   rpin:   right audio pin
    org
        xor     smp_l, ##$8000
        xor     smp_r, ##$8000
        wypin   smp_l, lpin                     ' Output sample on left channel
        wypin   smp_r, rpin                     ' Output sample on right channel
        waitse1
    end


PUB output8(sample) | L_PIN, R_PIN
' Output an 8-bit unsigned audio sample (mono)
'   sample: sample to output to both left and right channels
    longmove(@L_PIN, @_L_PIN, 2)

    org
        xor     sample, ##$8000
        and     sample, #$FF
        wypin   sample, L_PIN                   ' Output sample on left channel
        wypin   sample, R_PIN                   ' Output sample on right channel
        waitse1
    end


PUB output8_pin(sample, lpin, rpin)
' Output an 8-bit unsigned audio sample (mono)
'   sample: sample to output to both left and right channels
'   lpin:   left audio pin
'   rpin:   right audio pin
    org
        xor     sample, ##$8000
        and     sample, #$FF
        wypin   sample, lpin                    ' Output sample on left channel
        wypin   sample, rpin                    ' Output sample on right channel
        waitse1
    end


PUB output8_stereo(smp_l, smp_r) | L_PIN, R_PIN
' Output an 8-bit unsigned audio sample (stereo)
'   smp_l:  left-channel sample
'   smp_r:  right-channel sample
    longmove(@L_PIN, @_L_PIN, 2)
    org
        xor     smp_l, ##$8000
        xor     smp_r, ##$8000
        and     smp_l, #$ff
        and     smp_r, #$ff
        wypin   smp_l, L_PIN                    ' Output sample on left channel
        wypin   smp_r, R_PIN                    ' Output sample on right channel
        waitse1
    end


PUB output8_stereo_pin(smp_l, smp_r, lpin, rpin)
' Output an 8-bit unsigned audio sample (stereo)
'   smp_l:  left-channel sample
'   smp_r:  right-channel sample
'   lpin:   left audio pin
'   rpin:   right audio pin
    org
        xor     smp_l, ##$8000
        xor     smp_r, ##$8000
        and     smp_l, #$ff
        and     smp_r, #$ff
        wypin   smp_l, lpin                     ' Output sample on left channel
        wypin   smp_r, rpin                     ' Output sample on right channel
        waitse1
    end


DAT
