{
----------------------------------------------------------------------------------------------------
    Filename:       FXOS8700-Orientation-Demo.spin2
    Description:    Demo of the FXOS8700 driver
        * portrait/landscape orientation detection functionality
    Author:         Jesse Burt
    Started:        Nov 20, 2021
    Updated:        May 31, 2025
    Copyright (c) 2025 - See end of file for terms of use.
----------------------------------------------------------------------------------------------------
}

CON

    _clkfreq    = 180_000_000
    _xtlfreq    = 20_000_000


#include "core.con.click.spin2"
' -- User-modifiable constants
    CLICK_BASE  = 16                            ' MikroE Click board base I/O pin (multiple of 16)
'--


OBJ

    { MikroE Click boards (change CLICK_BASE above) }
    'sensor: "sensor.imu.6dof.fxos8700" | SCL=SCL_PIN, SDA=SDA_PIN, I2C_FREQ=400_000, I2C_ADDR=%11

    { custom I/O settings }
    sensor: "sensor.imu.6dof.fxos8700" | SCL=0, SDA=1, I2C_FREQ=400_000, I2C_ADDR=%11, RST_PIN=-1

    ser:    "com.serial.terminal.ansi" | SER_BAUD=2_000_000


PUB main()

    setup()
    sensor.preset_active()                      ' default settings, but enable
                                                ' sensor power, and set
                                                ' scale factors
    sensor.orient_detect_ena(true)              ' enable orientation detection

    repeat
        ser.pos_xy(0, 3)
        ser.str(@"Orientation: ")
        case sensor.orientation()
            sensor.PORTUP_FR:
                ser.str(@"Portrait-up, front-facing")
            sensor.PORTUP_BK:
                ser.str(@"Portrait-up, back-facing")
            sensor.PORTDN_FR:
                ser.str(@"Portrait-down, front-facing")
            sensor.PORTDN_BK:
                ser.str(@"Portrait-down, back-facing")
            sensor.LANDRT_FR:
                ser.str(@"Landscape-right, front-facing")
            sensor.LANDRT_BK:
                ser.str(@"Landscape-right, back-facing")
            sensor.LANDLT_FR:
                ser.str(@"Landscape-left, front-facing")
            sensor.LANDLT_BK:
                ser.str(@"Landscape-left, back-facing")
            other:
        ser.clear_line()

        if ( ser.getchar_noblock() == "c")      ' press the 'c' key in the demo
            cal_accel()                         ' to calibrate sensor offsets


PUB cal_accel()
' Calibrate the accelerometer
    ser.pos_xy(0, 5)
    ser.str(@"Calibrating accelerometer...")
    sensor.calibrate_accel()
    ser.pos_xy(0, 5)
    ser.clear_ln()


PUB setup()

    ser.start()

    ser.clear()
    ser.strln(@"Serial terminal started")

    if ( sensor.start() )
        ser.strln(@"FXOS8700 driver started (I2C)")
    else
        ser.strln(@"FXOS8700 driver failed to start - halting")
        repeat


DAT
