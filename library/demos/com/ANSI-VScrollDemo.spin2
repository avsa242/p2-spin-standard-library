{
---------------------------------------------------------------------------------------------------
    Filename:       ANSI-VScrollDemo.spin2
    Description:    Demo of the ANSI serial terminal driver
        * Vertical scrolling area demo
    Author:         Jesse Burt
    Started:        Aug 20, 2025
    Updated:        Aug 20, 2025
    Copyright (c) 2025 - See end of file for terms of use.
---------------------------------------------------------------------------------------------------
}

con

    _clkfreq    = 180_000_000
    _xtlfreq    = 20_000_000


obj

    ser:    "com.serial.terminal.ansi" | SER_BAUD=2_000_000


pub main() | i, top, bottom

    setup()
    ser.clear()
    ser.strln(@"Vertical scrolling area demo - press any key to quit and reset the terminal")

    top := 2                                    ' set the top and bottom rows of the scroll area
    bottom := 10
    ser.set_vscroll_area(top, bottom)           ' define scroll area and enable scrolling

    ser.pos_xy(0, bottom+2)
    ser.strln(@"This area (below the scroll area) isn't affected")

    ser.pos_xy(0, top)                          ' position the cursor at the scroll area start
    i := 0
    repeat                                      ' repeatedly print more lines to the terminal
        ser.printf(@"scroll %d\n\r", i++)       ' once the bottom of the scroll region is reached,
        if ( ser.getchar_noblock() >= 0 )       ' the terminal will scroll it up
            quit

    ser.clear()
    ser.reset()
    ser.disable_vscroll()
    ser.strln(@"Serial terminal reset")

    repeat


pub setup()

    ser.start()
    ser.reset()
    ser.clear()
    ser.strln(@"Serial terminal started")


dat
