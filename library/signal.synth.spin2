VAR

    byte _pin                                   ' stored I/O pin for signal generator methods


PUB set_amplitude(a)
' Set amplitude for running sine-wave generator
'   a:  amplitude (0..32767)
    _amp := a


PUB set_freq(freq)
' Set frequency for running sine-wave generator
'   freq:   frequency in Hz
    _freq := freq


PUB set_io_pin(pin)
' Set I/O pin for subsequent operations
    _pin := 0 #> pin <# 63


PUB sine_wave(freq, s_rate): c
' Synthesize a sine wave on the currently set pin (* requires cog)
'   freq:       initial frequency in Hz (modify during operation with set_freq() )
'   Returns:    cog ID of sinewave generator
    set_freq(freq)
    return cogspin(NEWCOG, cog_carrier_sine(_pin, s_rate), @_sine_stk)


VAR long _sine_stk[50], _freq, _amp, _phs1, _sine_cog
PRI cog_carrier_sine(ch1_pin, s_rate) | pin, smp
' Generate a continuous carrier wave (sine function)
'   ch1_pin:    channel 1 pin (0..63)
'   srate:      sample rate in Hz

' Runtime-modifiable parameters:
'   _phs1:      phase accumulator
'   _amp:       amplitude (0..32767)
'   _freq:      frequency

' Outputs:
'   _cog:       cog ID+1 this method is running in

' NOTE: This method calculates the period based on the system clock frequency at the time
'   it was started. It will need to be restarted if the system clock changes during operation.
    _sine_cog := cogid()+1
    pinstart(ch1_pin, (P_DAC_DITHER_RND | P_DAC_600R_2V | P_OE), (clkfreq/s_rate), 0)

    repeat
        _phs1 += _freq frac s_rate              ' step angle for sine freq
        _, smp := polxy(_amp, _phs1)            ' CORDIC sine
        wypin(ch1_pin, smp+$8000)               ' write sample to DAC
        repeat
        until pinr(ch1_pin)                     ' wait sample period


PUB square_wave(freq)
' Synthesize a square wave on the currently set pin
'   freq:   frequency in Hz
    pinstart(_pin, (P_NCO_FREQ | P_OE), 1, (freq frac clkfreq))


PUB square_wave_pin(pin, freq)
' Synthesize a square wave
'   pin:    I/O pin to output to
'   freq:   frequency in Hz
    pinstart(pin, (P_NCO_FREQ | P_OE), 1, (freq frac clkfreq))


DAT
