----------------------------------------------------------------------------------------------------

    NOTE: This file must be included by the compiler using the
        #include preprocessor directive, _outside_ of any existing
        block designators (CON, VAR, OBJ, PUB, PRI, DAT)
}

VAR

    long _gres, _gres_rads_sec                  ' scaling factors (int * 1_000_000)
    long _gres_dps_f, _gres_rads_sec_f          ' scaling factors (float)
    long _gbias[GYRO_DOF]


pub calibrate_gyro() | axis, orig_scl, orig_dr, tmpx, tmpy, tmpz, tmp[GYRO_DOF], samples
' Calibrate the gyroscope
    { save current settings }
    orig_scl := gyro_scale()
    orig_dr := gyro_data_rate()

    gyro_set_bias(0, 0, 0)                      ' clear existing bias

    { set sensor to driver-specific scale and data rate }
    gyro_scale(CAL_G_SCL)
    gyro_data_rate(CAL_G_DR)
    samples := CAL_G_DR                         ' samples = DR, for 1 sec time

    waitms(100)                                 ' let the gyro settle after changing the rate

    { accumulate and average approx. 1sec worth of samples }
    longfill(@tmpx, 0, 3+GYRO_DOF)              ' clear tmp vars to 0
    repeat samples
        repeat until gyro_data_rdy()
        gyro_data(@tmpx, @tmpy, @tmpz)
        tmp[X_AXIS] += tmpx
        tmp[Y_AXIS] += tmpy
        tmp[Z_AXIS] += tmpz

    { calculate averages }
    repeat axis from X_AXIS to Z_AXIS
        tmp[axis] /= samples

    { update offsets }
    gyro_set_bias(tmp[X_AXIS], tmp[Y_AXIS], tmp[Z_AXIS])

    { restore existing settings }
    gyro_scale(orig_scl)
    gyro_data_rate(orig_dr)


pub gyro_dps(gx, gy, gz) | tmp[GYRO_DOF]
' Read the Gyroscope output registers and scale the outputs to micro degrees per second
    gyro_data(@tmp[X_AXIS], @tmp[Y_AXIS], @tmp[Z_AXIS])
    long[gx] := gyro_word2dps(tmp[X_AXIS])
    long[gy] := gyro_word2dps(tmp[Y_AXIS])
    long[gz] := gyro_word2dps(tmp[Z_AXIS])


pub gyro_dps_f(gx, gy, gz) | tmp[GYRO_DOF]
' Read the Gyroscope output registers and scale the outputs to degrees per second (float)
    gyro_data(@tmp[X_AXIS], @tmp[Y_AXIS], @tmp[Z_AXIS])
    long[gx] := gyro_word2dpsf(tmp[X_AXIS])
    long[gy] := gyro_word2dpsf(tmp[Y_AXIS])
    long[gz] := gyro_word2dpsf(tmp[Z_AXIS])


pub gyro_rad_sec(gx, gy, gz) | tmp[GYRO_DOF]
' Read the Gyroscope output registers and scale the outputs to micro radians per second
    gyro_data(@tmp[X_AXIS], @tmp[Y_AXIS], @tmp[Z_AXIS])
    long[gx] := gyro_word2rps(tmp[X_AXIS])
    long[gy] := gyro_word2rps(tmp[Y_AXIS])
    long[gz] := gyro_word2rps(tmp[Z_AXIS])


pub gyro_rad_sec_f(gx, gy, gz) | tmp[GYRO_DOF]
' Read the Gyroscope output registers and scale the outputs to radians per second (float)
    gyro_data(@tmp[X_AXIS], @tmp[Y_AXIS], @tmp[Z_AXIS])
    long[gx] := gyro_word2rpsf(tmp[X_AXIS])
    long[gy] := gyro_word2rpsf(tmp[Y_AXIS])
    long[gz] := gyro_word2rpsf(tmp[Z_AXIS])


pub gyro_word2rps(gyro_word): r
' Convert gyroscope ADC word to micro-radians per second
    return (gyro_word * _gres_rads_sec)


pub gyro_word2rpsf(gyro_word): r
' Convert gyroscope ADC word to radians per second (float)
    return float(gyro_word) *. _gres_rads_sec_f


pub gyro_word2dps(gyro_word): d
' Convert gyroscope ADC word to micro-degrees per second
    return (gyro_word * _gres)


pub gyro_word2dpsf(gyro_word): d
' Convert gyroscope ADC word to degrees per second (float)
    return float(gyro_word) *. _gres_dps_f


DAT
