PUB accel_bias(x, y, z) | tmp
' Read accelerometer calibration offset values
    tmp := readreg(core.OFF_X, 3)
    _abias[X_AXIS] := long[x] := tmp.byte[X_AXIS] signx 7
    _abias[Y_AXIS] := long[y] := tmp.byte[Y_AXIS] signx 7
    _abias[Z_AXIS] := long[z] := tmp.byte[Z_AXIS] signx 7


PUB accel_set_bias(x, y, z)
' Write accelerometer calibration offset values
'   Valid values:
'       -128..127 (clamped to range)
    _abias[X_AXIS] := -(-128 #> x <# 127)
    _abias[Y_AXIS] := -(-128 #> y <# 127)
    _abias[Z_AXIS] := -(-128 #> z <# 127)
    cache_opmode()                              ' switch to stdby to mod regs
    writereg(core.OFF_X, _abias[X_AXIS])
    writereg(core.OFF_Y, _abias[Y_AXIS])
    writereg(core.OFF_Z, _abias[Z_AXIS])
    restore_opmode()                            ' restore original opmode


PUB accel_data(ptr_x, ptr_y, ptr_z) | tmp[2]
' Read the Accelerometer output registers
    readreg(core.OUT_X_MSB, 6, @tmp)
    long[ptr_x] := (tmp.word[2] sar 4) signx 11 ' output data is 12bit signed,
    long[ptr_y] := (tmp.word[1] sar 4) signx 11 '   left-justified; shift it
    long[ptr_z] := (tmp.word[0] sar 4) signx 11 '   down to the LSBit


PUB accel_data_overrun(): f
' Flag indicating previously acquired data has been overwritten
    return ( (readreg(core.STATUS) & core.ZYX_OW) <> 0)


PUB accel_data_rate(r=-2): cr
' Set accelerometer output data rate, in Hz
'   Valid values:
'       1 (1.56), 6 (6.25), 12 (12.5), 50, 100, 200, 400, 800
'   Any other value polls the chip and returns the current setting
    cr := readreg(core.CTRL_REG1)
    case r
        1, 6, 12, 50, 100, 200, 400, 800:
            if ( click_lpf_ena() )
                _accel_time_res := 2_500 #> ((1_000000 / r) * 2) <# 40_000
            else
                _accel_time_res := 1_250 #> ((1_000000 / r) / 2) <# 10_000
            r := lookdownz(r: 800, 400, 200, 100, 50, 12, 6, 1) << core.DR
            cache_opmode()                               ' switch to stdby to mod regs
            writereg(core.CTRL_REG1, ( (cr & core.DR_MASK) | r) )
            restore_opmode()                             ' restore original opmode
        other:
            cr := (cr >> core.DR) & core.DR_BITS
            return lookupz(cr: 800, 400, 200, 100, 50, 12, 6, 1)


PUB accel_data_rdy(): f
' Flag indicating new accelerometer data available
    return ( ( readreg(core.STATUS) & core.ZYX_DR) <> 0)


PUB accel_hpf_ena(s=-2): cs
' Enable accelerometer data high-pass filter
'   Valid values: TRUE (-1 or 1), FALSE (0)
'   Any other value polls the chip and returns the current setting
    cs := readreg(core.XYZ_DATA_CFG)
    case abs(s)
        0, 1:
            s := abs(s) << core.HPF_OUT
            writereg(core.XYZ_DATA_CFG, ( (cs & core.HPF_OUT_MASK) | s) )
        other:
            return ( ( (cs >> core.HPF_OUT) & 1) == 1)


PUB accel_hpf_freq(fr=-2): cf
' Set accelerometer data high-pass cutoff frequency, in milli-Hz
'   Valid values:
'   accel_pwr_mode():   NORMAL
'   accel_data_rate():  800, 400    200     100     50, 12, 6, 1
'                       16_000      8_000   4_000   2_000
'                       8_000       4_000   2_000   1_000
'                       4_000       2_000   1_000   500
'                       2_000       1_000   500     250
'   accel_pwr_mode():   LONOISE_LOPWR
'   accel_data_rate():  800, 400    200     100     50      12, 6, 1
'                       16_000      8_000   4_000   2_000   500
'                       8_000       4_000   2_000   1_000   250
'                       4_000       2_000   1_000   500     125
'                       2_000       1_000   500     250     63
'   accel_pwr_mode():   HIGHRES
'   accel_data_rate():  All
'                       16_000
'                       8_000
'                       4_000
'                       2_000
'   accel_pwr_mode():   LOPWR
'   accel_data_rate():  800     400     200     100     50      12, 6, 1
'                       16_000  8_000   4_000   2_000   1_000   250
'                       8_000   4_000   2_000   1_000   500     125
'                       4_000   2_000   1_000   500     250     63
'                       2_000   1_000   500     250     125     31
'   Any other value polls the chip and returns the current setting
    cf := readreg(core.HP_FILT_CUTOFF)
    case accel_pwr_mode()
        NORMAL:
            case accel_data_rate()
                800, 400:
                    case fr
                        16_000, 8_000, 4_000, 2_000:
                            fr := lookdownz(fr: 16_000, 8_000, 4_000, 2_000)
                        other:
                            cf &= core.SEL_BITS
                            return lookupz(cf: 16_000, 8_000, 4_000, 2_000)
                200:
                    case fr
                        8_000, 4_000, 2_000, 1_000:
                            fr := lookdownz(fr: 8_000, 4_000, 2_000, 1_000)
                        other:
                            cf &= core.SEL_BITS
                            return lookupz(cf: 8_000, 4_000, 2_000, 1_000)
                100:
                    case fr
                        4_000, 2_000, 1_000, 500:
                            fr := lookdownz(fr: 4_000, 2_000, 1_000, 500)
                        other:
                            cf &= core.SEL_BITS
                            return lookupz(cf: 4_000, 2_000, 1_000, 500)
                50, 12, 6, 1:
                    case fr
                        2_000, 1_000, 500, 250:
                            fr := lookdownz(fr: 2_000, 1_000, 500, 250)
                        other:
                            cf &= core.SEL_BITS
                            return lookupz(cf: 2_000, 1_000, 500, 250)
        LONOISE_LOPWR:
            case accel_data_rate()
                800, 400:
                    case fr
                        16_000, 8_000, 4_000, 2_000:
                            fr := lookdownz(fr: 16_000, 8_000, 4_000, 2_000)
                        other:
                            cf &= core.SEL_BITS
                            return lookupz(cf: 16_000, 8_000, 4_000, 2_000)
                200:
                    case fr
                        8_000, 4_000, 2_000, 1_000:
                            fr := lookdownz(fr: 8_000, 4_000, 2_000, 1_000)
                        other:
                            cf &= core.SEL_BITS
                            return lookupz(cf: 8_000, 4_000, 2_000, 1_000)
                100:
                    case fr
                        4_000, 2_000, 1_000, 500:
                            fr := lookdownz(fr: 4_000, 2_000, 1_000, 500)
                        other:
                            cf &= core.SEL_BITS
                            return lookupz(cf: 4_000, 2_000, 1_000, 500)
                50:
                    case fr
                        2_000, 1_000, 500, 250:
                            fr := lookdownz(fr: 2_000, 1_000, 500, 250)
                        other:
                            cf &= core.SEL_BITS
                            return lookupz(cf: 2_000, 1_000, 500, 250)
                12, 6, 1:
                    case fr
                        500, 250, 125, 63:
                            fr := lookdownz(fr: 500, 250, 125, 63)
                        other:
                            cf &= core.SEL_BITS
                            return lookupz(cf: 500, 250, 125, 63)
        HIGHRES:
            case fr
                2_000, 4_000, 8_000, 16_000:
                    fr := lookdownz(fr: 16_000, 8_000, 4_000, 2_000)
        LOPWR:
            case accel_data_rate()
                800:
                    case fr
                        16_000, 8_000, 4_000, 2_000:
                            fr := lookdownz(fr: 16_000, 8_000, 4_000, 2_000)
                        other:
                            cf &= core.SEL_BITS
                            return lookupz(cf: 16_000, 8_000, 4_000, 2_000)
                400:
                    case fr
                        8_000, 4_000, 2_000, 1_000:
                            fr := lookdownz(fr: 8_000, 4_000, 2_000, 1_000)
                        other:
                            cf &= core.SEL_BITS
                            return lookupz(cf: 8_000, 4_000, 2_000, 1_000)
                200:
                    case fr
                        4_000, 2_000, 1_000, 500:
                            fr := lookdownz(fr: 4_000, 2_000, 1_000, 500)
                        other:
                            cf &= core.SEL_BITS
                            return lookupz(cf: 4_000, 2_000, 1_000, 500)
                100:
                    case fr
                        2_000, 1_000, 500, 250:
                            fr := lookdownz(fr: 2_000, 1_000, 500, 250)
                        other:
                            cf &= core.SEL_BITS
                            return lookupz(cf: 2_000, 1_000, 500, 250)
                50:
                    case fr
                        1_000, 500, 250, 125:
                            fr := lookdownz(fr: 1_000, 500, 250, 125)
                        other:
                            cf &= core.SEL_BITS
                            return lookupz(cf: 1_000, 500, 250, 125)
                12, 6, 1:
                    case fr
                        250, 125, 63, 31:
                            fr := lookdownz(fr: 250, 125, 63, 31)
                        other:
                            cf &= core.SEL_BITS
                            return lookupz(cf: 250, 125, 63, 31)
    writereg(core.HP_FILT_CUTOFF, ( (cf & core.SEL_MASK) | fr) )


con #0, INTMD_PP, INTMD_OD
PUB accel_int_output_mode(m=-2): c
' Set the INTx pins output mode
'   m:
'       INTMD_PP (0):   Push-pull (default)
'       INTMD_OD (1):   Open-drain
'       other values:   return the current setting
    c := readreg(core.CTRL_REG3)
    case m
        INTMD_PP, INTMD_OD:
            writereg(core.CTRL_REG3, (c & core.PP_OD_MASK) | m)
        other:
            return (c & 1)


PUB accel_int_polarity(s=-2): cs
' Set interrupt pin active state/logic level
'   Valid values: LOW (0), HIGH (1)
'   Any other value polls the chip and returns the current setting
    cs := readreg(core.CTRL_REG3)
    case s
        LOW, HIGH:
            cache_opmode()
            writereg(core.CTRL_REG3, ( (cs & core.IPOL_MASK) | (s << core.IPOL) ) )
            restore_opmode()
        other:
            return ((cs >> core.IPOL) & 1)


PUB accel_int(): i
' Flag indicating one or more interrupts asserted
'   Interrupt flags:
'       Bits [7..0] (OR together symbols, as needed)
'       7: INT_AUTOSLPWAKE - Auto-sleep/wake
'       6: INT_FIFO - FIFO (FXOS8700 only)
'       5: INT_TRANS - Transient
'       4: INT_ORIENT - Orientation (landscape/portrait)
'       3: INT_PULSE - Pulse detection
'       2: INT_FFALL - Freefall/motion
'       1: INT_VECM - Vector/magnitude (FXOS8700 only)
'       0: INT_DRDY - Data ready
    return readreg(core.INT_SOURCE)


PUB accel_int_mask(m=-2): cm
' Set interrupt mask
'   Valid values:
'       Bits [7..0] (OR together symbols, as needed)
'       7: INT_AUTOSLPWAKE - Auto-sleep/wake
'       6: INT_FIFO - FIFO (FXOS8700 only)
'       5: INT_TRANS - Transient
'       4: INT_ORIENT - Orientation (landscape/portrait)
'       3: INT_PULSE - Pulse detection
'       2: INT_FFALL - Freefall/motion
'       1: INT_VECM - Acceleration vector/magnitude (FXOS8700 only)
'       0: INT_DRDY - Data ready
'   Any other value polls the chip and returns the current setting
    case m
        %00000000..%11111111:
            cache_opmode()                       ' switch to stdby to mod regs
            writereg(core.CTRL_REG4, m)
            restore_opmode()                     ' restore original opmode
        other:
            return readreg(core.CTRL_REG4)


PUB accel_int_routing(m=-2): cm
' Set routing of interrupt sources to INT1 or INT2 pin
'   Valid values:
'       Setting a bit routes the interrupt to INT1
'       Clearing a bit routes the interrupt to INT2
'
'       Bits [7..0] (OR together symbols, as needed)
'       7: INT_AUTOSLPWAKE - Auto-sleep/wake
'       6: INT_FIFO - FIFO (FXOS8700 only)
'       5: INT_TRANS - Transient
'       4: INT_ORIENT - Orientation (landscape/portrait)
'       3: INT_PULSE - Pulse detection
'       2: INT_FFALL - Freefall/motion
'       1: INT_VECM - Vector/magnitude (FXOS8700 only)
'       0: INT_DRDY - Data ready
'   Any other value polls the chip and returns the current setting
    case m
        %00000000..%11111111:
            cache_opmode()                       ' switch to stdby to mod regs
            writereg(core.CTRL_REG5, m)
            restore_opmode()                     ' restore original opmode
        other:
            return readreg(core.CTRL_REG5)


PUB accel_lpf_ena(s=-2): cs
' Enable accelerometer data low-pass filter
'   Valid values: TRUE (-1 or 1), *FALSE (0)
'   Any other value polls the chip and returns the current setting
'   NOTE: This option simply enables a reduced noise mode - it doesn't
'       provide a LPF cutoff frequency setting, as in other IMUs
'   NOTE: This option cannot be used in 8g scale. If the accelerometer
'       scale is currently set to 8g, enabling this filter will be ignored
    cs := readreg(core.CTRL_REG1)
    case abs(s)
        0, 1:
            cache_opmode()                               ' switch to stdby to mod regs
            writereg(core.CTRL_REG1, (cs & core.LNOISE_MASK) | (s << core.LNOISE) )
            restore_opmode()                             ' restore original opmode
        other:
            return ((cs >> core.LNOISE) & 1) == 1


PUB accel_opmode(m=-2): cm
' Set accelerometer operating mode
'   Valid values:
'       STDBY (0): stand-by
'       ACTIVE (1): active
'   Any other value polls the chip and returns the current setting
    cm := readreg(core.CTRL_REG1)
    case m
        STDBY, ACTIVE:
            writereg(core.CTRL_REG1, ( (cm & core.ACTIVE_MASK) | m) )
        other:
            return (cm & 1)


PUB accel_pwr_mode(m=-2): cm ' XXX tentatively named
' Set accelerometer power mode/oversampling mode, when active
'   Valid values:
'       NORMAL (0): Normal
'       LONOISE_LOPWR (1): Low noise low power
'       HIGHRES (2): High resolution
'       LOPWR (3): Low power
'   Any other value polls the chip and returns the current setting
    cm := readreg(core.CTRL_REG2)
    case m
        NORMAL, LONOISE_LOPWR, HIGHRES, LOPWR:
            cache_opmode()                               ' switch to stdby to mod regs
            writereg(core.CTRL_REG2, ( (cm & core.MODS_MASK) | m) )
            restore_opmode()                             ' restore original opm
        other:
            return (cm & core.MODS_BITS)


PUB accel_scale(s=-2): cs
' Set the full-scale range of the accelerometer, in g's
    cs := readreg(core.XYZ_DATA_CFG)
    case s
        2, 4, 8:
            s := lookdownz(s: 2, 4, 8)
            ' _ares = 1 / 1024 counts/g (2g), 512 (4g), or 256 (8g)
            ' micro-gs per LSB
            _ares := lookupz(s: 0_000976, 0_001953, 0_003906)
            cache_opmode()                               ' switch to stdby to mod regs
            writereg(core.XYZ_DATA_CFG, ( (cs & core.FS_MASK) | s) )
            restore_opmode()                             ' restore original opmode
        other:
            return lookupz(cs & core.FS_BITS: 2, 4, 8)


PUB accel_self_test(s=-2): cs
' Enable accelerometer self-test
'   Valid values: TRUE (-1 or 1), FALSE (0)
'   Any other value polls the chip and returns the current setting
'   During self-test, the output data changes approximately as follows
'       (typ. values @ 4g full-scale)
'       X: +0.085g (44LSB * 1953 micro-g per LSB)
'       Y: +0.119g (61LSB * 1953 micro-g per LSB)
'       Z: +0.765g (392LSB * 1953 micro-g per LSB)
    cs := readreg(core.CTRL_REG2)
    case abs(s)
        0, 1:
            cache_opmode()
            writereg(core.CTRL_REG2, ( (cs & core.ST_MASK) | (s & 1) << core.ST) )
            restore_opmode()
        other:
            return ( ( (cs >> core.ST) & 1) == 1)


PUB accel_sleep_pwr_mode(m=-2): cm
' Set accelerometer power mode/oversampling mode, when sleeping
'   Valid values:
'       NORMAL (0): Normal
'       LONOISE_LOPWR (1): Low noise low power
'       HIGHRES (2): High resolution
'       LOPWR (3): Low power
'   Any other value polls the chip and returns the current setting
    cm := readreg(core.CTRL_REG2)
    case m
        NORMAL, LONOISE_LOPWR, HIGHRES, LOPWR:
            cache_opmode()
            writereg(core.CTRL_REG2, ((cm & core.SMODS_MASK) | (m << core.SMODS) ) )
            restore_opmode()
        other:
            return ((cm >> core.SMODS) & core.SMODS_BITS)


PUB auto_sleep_data_rate(r=-2): cr
' Set accelerometer output data rate, in Hz, when in sleep mode
'   Valid values: 1, 6, 12, 50
'   Any other value polls the chip and returns the current setting
    cr := readreg(core.CTRL_REG1)
    case r
        1, 6, 12, 50:
            r := lookdownz(r: 50, 12, 6, 1) << core.ASLP_RATE
            cache_opmode()
            writereg(core.CTRL_REG1, ( (cr & core.ASLP_RATE_MASK) | r) )
            restore_opmode()
        other:
            cr := ( (cr >> core.ASLP_RATE) & core.ASLP_RATE_BITS)
            return lookupz(cr: 50, 12, 6, 1)


PUB auto_sleep_ena(s=-2): cs
' Enable automatic transition to sleep state when inactive
'   Valid values: TRUE (-1 or 1), FALSE (0)
'   Any other value polls the chip and returns the current setting
    cs := readreg(core.CTRL_REG2)
    case abs(s)
        0, 1:
            s := abs(s) << core.SLPE
            cache_opmode()
            writereg(core.CTRL_REG2, ( (cs & core.SLPE_MASK) | s) )
            restore_opmode()
        other:
            return ( ( (cs >> core.SLPE) & 1) == 1)


PUB click_axis_ena(m=-2): cm
' Enable click detection per axis, and per click type
'   Valid values:
'       Bits: 5..0
'       [5..4]: Z-axis double-click..single-click
'       [3..2]: Y-axis double-click..single-click
'       [1..0]: X-axis double-click..single-click
'   Any other value polls the chip and returns the current setting
    cm := readreg(core.PULSE_CFG)
    case m
        %000000..%111111:
            writereg(core.PULSE_CFG, ( (cm & core.PEFE_MASK) | m) )
        other:
            return cm & core.PEFE_BITS


PUB clicked(): f
' Flag indicating the sensor was single or double-clicked
'   Returns: TRUE (-1) if sensor was single-clicked or double-clicked
'            FALSE (0) otherwise
    return ( ( (clicked_int() >> core.EA) & 1) <> 0)


PUB clicked_int(): i
' Clicked interrupt status
'   Bits: 7..0
'       7: Interrupt active
'       6: Z-axis clicked
'       5: Y-axis clicked
'       4: X-axis clicked
'       3: Double-click on first event
'       2: Z-axis polarity (0: positive, 1: negative)
'       1: Y-axis polarity (0: positive, 1: negative)
'       0: X-axis polarity (0: positive, 1: negative)
    return readreg(core.PULSE_SRC)


PUB click_int_ena(s=-2): cs
' Enable click interrupts on INT1
'   Valid values: TRUE (-1 or 1), FALSE (0)
'   Any other value polls the chip and returns the current setting
    cs := readreg(core.CTRL_REG4)
    case abs(s)
        0, 1:
            s := abs(s) << core.INT_EN_PULSE
            writereg(core.CTRL_REG4, ( (cs & core.IE_PULSE_MASK) | s) )
        other:
            return ( ( (cs >> core.INT_EN_PULSE) & 1) == 1)


PUB click_latency(): t
' Get minimum elapsed time from detection of first click to recognition of any subsequent clicks
'   (single or double). All clicks *during* this time will be ignored.
'   Returns: microseconds
    return ( readreg(core.PULSE_LTCY) * _accel_time_res)


PUB click_set_latency(t)
'   Set minimum elapsed time from detection of first click to recognition of
'       any subsequent clicks (single or double), in microseconds. All clicks
'       *during* this time will be ignored.
'   Valid values:
'                                   Max time range
'                           click_lpf_ena()
'       accel_data_rate():    == 0        == 1
'       800                 318_000     638_000
'       400                 318_000     1_276_000
'       200                 638_000     2_560_000
'       100                 1_276_000   5_100_000
'       50                  2_560_000   10_200_000
'       12                  2_560_000   10_200_000
'       6                   2_560_000   10_200_000
'       1                   2_560_000   10_200_000
'   Any other value polls the chip and returns the current setting
    ' check that the parameter is between 0 and the max time range for
    '   the current accel_data_rate() setting
    writereg(core.PULSE_LTCY, (0 #> t <# (_accel_time_res * 255) ) / _accel_time_res )


PUB click_lpf_ena(s=-2): cs
' Enable click detection low-pass filter
'   Valid Values: TRUE (-1 or 1), FALSE (0)
'   Any other value polls the chip and returns the current setting
    cs := readreg(core.HP_FILT_CUTOFF)
    case abs(s)
        0, 1:
            s := abs(s) << core.PLS_LPF_EN
            writereg(core.HP_FILT_CUTOFF, ( (cs & core.PLS_LPF_EN_MASK) | s) )
        other:
            return ( ( (cs >> core.PLS_LPF_EN) & 1) == 1)


PUB click_thresh(): t
' dummy method for compatibility with other drivers


PUB click_set_thresh(t)
' Set threshold for recognizing a click (all axes), in micro-g's
'   Valid values:
'       0..8_000000 (8g's)
'   NOTE: The allowed range is fixed at 8g's, regardless of the current
'       setting of accel_scale()
'   NOTE: If accel_low_noise_mode() is set to LOWNOISE, the maximum threshold
'       recognized using this method will be 4_000000 (4g's)
    t := 0 #> t <# 8_000000
    click_set_thresh_x(t)
    click_set_thresh_y(t)
    click_set_thresh_z(t)


PUB click_thresh_x(): t
' Get threshold for recognizing a click (X-axis)
'   Returns: micro-g's
    return (readreg(core.PULSE_THSX) * 0_063000)             ' scale to 1..8_000000 (8g's)


PUB click_set_thresh_x(t)
' Set threshold for recognizing a click (X-axis), in micro-g's
'   Valid values:
'       0..8_000000 (8g's)
'   Any other value polls the chip and returns the current setting
'   NOTE: The allowed range is fixed at 8g's, regardless of the current
'       setting of accel_scale()
'   NOTE: If accel_low_noise_mode() is set to LOWNOISE, the maximum threshold
'       recognized using this method will be 4_000000 (4g's)
    writereg(core.PULSE_THSX, (t / 0_063000) )


PUB click_thresh_y(): t
' Get threshold for recognizing a click (Y-axis)
'   Returns: micro-g's
    return ( readreg(core.PULSE_THSY) * 0_063000)             ' scale to 1..8_000000 (8g's)


PUB click_set_thresh_y(t)
' Set threshold for recognizing a click (Y-axis), in micro-g's
'   Valid values:
'       0..8_000000 (8g's)
'   Any other value polls the chip and returns the current setting
'   NOTE: The allowed range is fixed at 8g's, regardless of the current
'       setting of accel_scale()
'   NOTE: If accel_low_noise_mode() is set to LOWNOISE, the maximum threshold
'       recognized using this method will be 4_000000 (4g's)
    writereg(core.PULSE_THSY, (t / 0_063000) )


PUB click_thresh_z(): t
' Get threshold for recognizing a click (Z-axis)
'   Returns: micro-g's
    return (readreg(core.PULSE_THSZ) * 0_063000)             ' scale to 1..8_000000 (8g's)


PUB click_set_thresh_z(t)
' Set threshold for recognizing a click (Z-axis), in micro-g's
'   Valid values:
'       0..8_000000 (8g's)
'   Any other value polls the chip and returns the current setting
'   NOTE: The allowed range is fixed at 8g's, regardless of the current
'       setting of accel_scale()
'   NOTE: If accel_low_noise_mode() is set to LOWNOISE, the maximum threshold
'       recognized using this method will be 4_000000 (4g's)
    writereg(core.PULSE_THSZ, (t / 0_063000) )


PUB click_time(): t
' Get maximum elapsed interval between start of click and end of click
'   Returns: microseconds
    return (readreg(core.PULSE_TMLT) * _accel_time_res)


PUB click_set_time(t)
' Set maximum elapsed interval between start of click and end of click, in uSec
'   (i.e., time from set ClickThresh exceeded to falls back below threshold)
'   Valid values:
'                                   Max time range
'                           click_lpf_ena()
'       accel_data_rate():    == 0        == 1
'       800                 159_000     319_000
'       400                 159_000     638_000
'       200                 319_000     1_280_000
'       100                 638_000     2_550_000
'       50                  1_280_000   5_100_000
'       12                  1_280_000   5_100_000
'       6                   1_280_000   5_100_000
'       1                   1_280_000   5_100_000
    writereg(core.PULSE_TMLT, ((0  #> t <# (_accel_time_res * 255) ) / _accel_time_res) )


PUB dbl_click_win(): t
' Set maximum elapsed interval between two consecutive clicks
'   Returns: microseconds
    return (readreg(core.PULSE_WIND) * _accel_time_res)


PUB dbl_click_set_win(t)
' Set maximum elapsed interval between two consecutive clicks, in uSec
'   Valid values:
'                                   Max time range
'                           click_lpf_ena()
'       accel_data_rate():    == 0        == 1
'       800                 318_000     638_000
'       400                 318_000     1_276_000
'       200                 638_000     2_560_000
'       100                 1_276_000   5_100_000
'       50                  2_560_000   10_200_000
'       12                  2_560_000   10_200_000
'       6                   2_560_000   10_200_000
'       1                   2_560_000   10_200_000
    writereg(core.PULSE_WIND, ( (0 #> t <# (_accel_time_res * 255) ) / _accel_time_res) )


PUB freefall_axis_ena(m=-2): cm
' Enable free-fall detection, per axis mask
'   Valid values: %000..%111 (ZYX)
'   Any other value polls the chip and returns the current setting
    cm := readreg(core.FF_MT_CFG)
    case m
        %000..%111:
            m <<= core.FEFE
            writereg(core.FF_MT_CFG, ( (cm & core.FEFE_MASK) | m) )
        other:
            return ((cm >> core.FEFE) & core.FEFE_BITS)


PUB freefall_thresh(t=-2): ct
' Set free-fall threshold, in micro-g's
'   Valid values: 0..8_001000 (0..8g's)
'   Any other value polls the chip and returns the current setting
    ct := readreg(core.FF_MT_THS)
    case t
        0..8_001000:
            t /= 0_063000
            writereg(core.FF_MT_THS, ( (ct & core.FF_THS_MASK) | t) )
        other:
            return ((ct & core.FF_THS_BITS) * 0_063000)


PUB freefall_time(): ct | tr
' Get minimum time duration required to recognize free-fall
'   Returns: microseconds
    case accel_pwr_mode()
        NORMAL:
            tr := 1_250 #> _accel_time_res <# 20_000
        LONOISE_LOPWR:
            tr := 1_250 #> _accel_time_res <# 80_000
        HIGHRES:
            tr := 1_250 #> _accel_time_res <# 2_500
        LOPWR:
            tr := 1_250 #> _accel_time_res <# 160_000

    return (readreg(core.FF_MT_CNT) * tr)


PUB freefall_set_time(t) | tr
' Set minimum time duration required to recognize free-fall, in microseconds
'   Valid values: 0..maximum in table below:
'                           accel_pwr_mode():
'       accel_data_rate():    NORMAL     LONOISE_LOPWR   HIGHRES     LOPWR
'       800Hz               319_000    319_000         319_000     319_000
'       400                 638_000    638_000         638_000     638_000
'       200                 1_280      1_280           638_000     1_280
'       100                 2_550      2_550           638_000     2_550
'       50                  5_100      5_100           638_000     5_100
'       12                  5_100      20_400          638_000     20_400
'       6                   5_100      20_400          638_000     40_800
'       1                   5_100      20_400          638_000     40_800
'   Any other value polls the chip and returns the current setting
    case accel_pwr_mode()
        NORMAL:
            tr := 1_250 #> _accel_time_res <# 20_000
        LONOISE_LOPWR:
            tr := 1_250 #> _accel_time_res <# 80_000
        HIGHRES:
            tr := 1_250 #> _accel_time_res <# 2_500
        LOPWR:
            tr := 1_250 #> _accel_time_res <# 160_000

    writereg(core.FF_MT_CNT, (( 0 #> t <# (tr * 255) ) / tr) )


PUB inact_int(m=-2): cm
' Set inactivity interrupt mask
'   Valid values:
'       Bits [3..0]
'       3: Wake on transient interrupt
'       2: Wake on orientation interrupt
'       1: Wake on pulse/click/tap interrupt
'       0: Wake on free-fall/motion interrupt
'   Any other value polls the chip and returns the current setting
    cm := readreg(core.CTRL_REG3)
    case m
        %0000..%1111:
            cache_opmode()
            writereg(core.CTRL_REG3, ( (cm & core.WAKE_MASK) | (m << core.WAKE) ) )
            restore_opmode()
        other:
            return ( (cm >> core.WAKE) & core.WAKE_BITS)


PUB inact_thresh(): t
' Get inactivity threshold
    return readreg(core.TRANSIENT_THS)


PUB inact_set_thresh(t)
' Set inactivity threshold
'   Valid values: 0..127
'   Any other value polls the chip and returns the current setting
    writereg(core.TRANSIENT_THS, (0 #> t <# 127) )


PUB inact_time(): t | tr
' Get inactivity time
'   Returns: milliseconds
    if ( accel_data_rate() == 1 )
        tr := 640                         ' 640ms time step for 1Hz ODR
    else
        tr := 320                         ' 320ms time step for others
    max_dur := (tr * 255)                 ' calc max possible duration

    t := readreg(core.ASLP_CNT)
    if ( opmode == BOTH )
        return ( (t * tr) * 2)
    else
        return (t * tr)


PUB inact_set_time(t) | tr
' Set inactivity time, in milliseconds
'   Valid values:
'       0..163_200 (accel_data_rate() == 1)
'       0..81_600 (accel_data_rate() == all other settings)
'   NOTE: Setting this to 0 will generate an interrupt when the acceleration
'       measures less than that set with inact_set_thresh()
#ifdef FXOS8700
    if ( opmode == BOTH )                       ' cut the set time in half if both sensors
        t /= 2                              '   are being used
#endif
    if ( accel_data_rate() == 1 )
        tr := 640                         ' 640ms time step for 1Hz ODR
    else
        tr := 320                         ' 320ms time step for others

    cache_opmode()
    writereg(core.ASLP_CNT, ((0  #> t <# (tr * 255) ) / tr) )
    restore_opmode()


PUB in_freefall(): f
' Flag indicating device is in free-fall
'   Returns:
'       TRUE (-1): device is in free-fall
'       FALSE (0): device isn't in free-fall
    return ( ( (readreg(core.FF_MT_SRC) >> core.FEA) & 1) == 1)


PUB motion_int_enabled(m=-2): c
' Enable motion-related interrupt
'   m:
'       true (-1 or 1): enable motion interrupt
'       false (0):      enable free-fall interrupt (default)
'       other values:   return the current setting
    c := readreg(core.FF_MT_CFG)
    if ( m == 0 or abs(m) == 1 )
        writereg(core.FF_MT_CFG, (c & core.FOAE_MASK) | (abs(m) << core.FOAE) )
    else
        return (c >> core.FOAE) & 1


PUB orientation(): co
' Current orientation
'   Returns:
'       %000: portrait-up, front-facing
'       %001: portrait-up, back-facing
'       %010: portrait-down, front-facing
'       %011: portrait-down, back-facing
'       %100: landscape-right, front-facing
'       %101: landscape-right, back-facing
'       %110: landscape-left, front-facing
'       %111: landscape-left, back-facing
    return (readreg(core.PL_STATUS) & core.LAPOBAFRO_BITS)


PUB orient_detect_ena(s=-2): cs
' Enable orientation detection
'   Valid values: TRUE (-1 or 1), FALSE (0)
'   Any other value polls the chip and returns the current setting
    cs := readreg(core.PL_CFG)
    case abs(s)
        0, 1:
            s := abs(s) << core.PL_EN
            cache_opmode()                               ' switch to stdby to mod regs
            writereg(core.PL_CFG, ( (cs & core.PL_EN_MASK) | s) )
            restore_opmode()                             ' restore original opmode
        other:
            return ((cs >> core.PL_EN) & 1) == 1


PUB trans_cnt(): s
' Get minimum number of debounced samples that must be greater than the
'   threshold set by trans_set_thresh() to generate an interrupt
    return readreg(core.TRANSIENT_CNT)


PUB trans_set_cnt(s)
' Set minimum number of debounced samples that must be greater than the
'   threshold set by trans_set_thresh() to generate an interrupt
'   Valid values: 0..255
'   Any other value polls the chip and returns the current setting
    writereg(core.TRANSIENT_CNT, (0 #> s <# 255) )


PUB trans_axis_ena(m=-2): cm
' Enable transient acceleration detection, per mask
'   Valid values:
'       Bits [2..0]
'       2: Enable transient acceleration interrupt on Z-axis
'       1: Enable transient acceleration interrupt on Y-axis
'       0: Enable transient acceleration interrupt on X-axis
'   Any other value polls the chip and returns the current setting
    cm := readreg(core.TRANSIENT_CFG)
    case m
        %000..%111:
            cache_opmode()
            ' set the new enable mask, and also latch transient interrupts
            writereg(   core.TRANSIENT_CFG, ...
                        ( (cm & core.TEFE_MASK) | (m << core.TEFE) ) ...
                        | 1 << core.TELE )
            restore_opmode()
        other:
            return ( (cm >> core.TEFE) & core.TEFE_BITS)


PUB trans_interrupt(): i
' Read transient acceleration interrupt(s)
'   Bits [6..0]
'   6: One or more interrupts asserted
'   5: Z-axis transient interrupt
'   4: Z-axis transient interrupt polarity (0: positive, 1: negative)
'   3: Y-axis transient interrupt
'   2: Y-axis transient interrupt polarity (0: positive, 1: negative)
'   1: X-axis transient interrupt
'   0: X-axis transient interrupt polarity (0: positive, 1: negative)
    return readreg(core.TRANSIENT_SRC)


PUB trans_thresh(t=-2): ct
' Set threshold for transient acceleration detection, in micro-g's
'   Valid values: 0..8_001000 (0..8gs)
'   Any other value polls the chip and returns the current setting
'   NOTE: If accel_pwr_mode() == LOWNOISE, the maximum value is reduced
'       to 4g's (4_000000)
    ct := readreg(core.TRANSIENT_THS)
    case t
        0..8_001000:
            writereg(core.TRANSIENT_THS, ( (ct & core.THS_MASK) | (t / 0_063000) ) )
        other:
            return ( (ct & core.THS_BITS) * 0_063000)



